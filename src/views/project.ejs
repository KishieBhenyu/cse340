<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>

    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>

    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <section>
    <h3>Categories</h3>

    <% if (categories && categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No categories assigned.</p>
    <% } %>

   <% if (user && user.role_name === 'admin') { %>
    <a href="/edit-project/<%= project.project_id %>">
        Edit Project
    </a>

    <a href="/project/<%= project.project_id %>/assign-categories">
        Categories
    </a>
<% } %>

</section>



    <p>
        <a href="/projects">← Back to Projects</a>
    </p>
</main>

<%- include('partials/footer') %>