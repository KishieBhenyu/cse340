<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">

        <!-- PROJECT TITLE -->
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                maxlength="200"
                required
            >
        </div>

        <!-- DESCRIPTION -->
        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="1000"
                required
            ><%= project.description %></textarea>
        </div>

        <!-- LOCATION -->
        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location %>"
                maxlength="200"
                required
            >
        </div>

        <!-- DATE -->
        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= project.date.toISOString().split('T')[0] %>"
                required
            >
        </div>

        <!-- ORGANIZATION DROPDOWN -->
        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>

                <% organizations.forEach(org => { %>
                    <option
                        value="<%= org.organization_id %>"
                        <%= project.organization_id === org.organization_id ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }) %>

            </select>
        </div>

        <!-- SUBMIT -->
        <button type="submit">Update Project</button>

    </form>
</main>

<%- include('partials/footer') %>