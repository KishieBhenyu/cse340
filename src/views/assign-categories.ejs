<%- include('partials/header') %>

<main>
    <h1>Assign Categories to Project</h1>

    <h2><%= projectDetails.title %></h2>

    <form action="/project/<%= projectId %>/assign-categories" method="POST">

        <div class="form-group">
            <% categories.forEach(category => { %>
                <div>
                    <label>
                        <input
                            type="checkbox"
                            name="categoryIds"
                            value="<%= category.category_id %>"
                            <%= assignedCategories.some(ac => Number(ac.category_id) === Number(category.category_id)) ? 'checked' : '' %>
                        >
                        <%= category.category_name %>
                    </label>
                </div>
            <% }) %>
        </div>

        <button type="submit">Update Categories</button>

    </form>

</main>

<%- include('partials/footer') %>