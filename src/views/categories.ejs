<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>

        <h1>Categories</h1>

<p>
    <a href="/new-category" class="btn btn-primary">
        + Add Category
    </a>
</p>

        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>