<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>

        <h1>Categories</h1>

<% if (user && user.role_name === 'admin') { %>
    <a href="/new-category">Add New Category</a>
<% } %>

        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>